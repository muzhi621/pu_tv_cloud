# 复制为 .env 并按部署环境填写；不要提交真实 Token。
# 两个 Token 都留空 = 开发模式（接口不鉴权），仅允许本机/内网使用。

CONFIG_READ_TOKEN=
CONFIG_WRITE_TOKEN=

# 编辑器与 API 同源部署时无需 CORS。跨域部署请填精确域名，切勿使用 *。
CONFIG_CORS_ORIGINS=

# file（默认，本地/单机）| oss（阿里云 FC）
CONFIG_STORAGE_BACKEND=file
CONFIG_DATA_DIR=

# 以下仅 OSS 后端使用；OSSStorage 只支持 AK/SK 明文凭证，不支持函数 RAM 角色。
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=pure_live_tv/

# FC Web 函数 / 本地服务监听端口
PORT=8080
