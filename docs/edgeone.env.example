# 在 EdgeOne Pages 控制台「项目设置 - 环境变量」里填写；不要写进代码仓库。
# 两个 token 都留空 = devMode（不鉴权，仅限本地调试）。
CONFIG_READ_TOKEN=
CONFIG_WRITE_TOKEN=

# KV 命名空间绑定到项目时使用的「变量名」，必须与控制台一致。
# 控制台：存储 - KV → 创建命名空间 → 绑定项目 → 变量名填 PURETV_KV。
CONFIG_KV_BINDING=PURETV_KV

# 可选：跨域访问编辑器时填写来源域名，多个用逗号分隔；同源部署留空。
CONFIG_CORS_ORIGINS=

# 编辑器连接信息自动预填（默认 1）。打开编辑器页面时由 Edge Function 把
# CONFIG_READ_TOKEN / CONFIG_WRITE_TOKEN / 当前域名注入页面，令牌不写进公开仓库。
# 设 0 关闭，页面恢复为手动填写。注意：能访问该页面的人可在源码里看到写令牌。
CONFIG_EDITOR_PRELOAD=1

# 终端在线判定窗口（分钟），默认 30。客户端前台每 15 分钟同步一次配置。
CONFIG_ONLINE_WINDOW_MINUTES=30
